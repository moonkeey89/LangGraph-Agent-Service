DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选；不配置时沿用 ChatOpenAI 当前的默认行为
# DEEPSEEK_TEMPERATURE=0

# 本地多语言 Embedding；首次使用长期记忆时下载到本机模型缓存
MEMORY_EMBEDDING_MODEL=minishlab/potion-multilingual-128M
MEMORY_EMBEDDING_DIMENSIONS=256
MEMORY_MANAGER_CONFIDENCE_THRESHOLD=0.75

# Supervisor 每轮允许的高层 Subagent 调用上限
SUPERVISOR_MAX_SUBAGENT_CALLS=4

# RAG知识库；CLI默认使用demo，浏览器通过受控选择器传入并由后端验证所有权
KNOWLEDGE_BASE_ID=demo
KNOWLEDGE_CHROMA_DIRECTORY=data/knowledge_chroma
KNOWLEDGE_CATALOG_PATH=data/knowledge_catalog.sqlite
KNOWLEDGE_SOURCE_DIRECTORY=data/knowledge_sources
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=120
KNOWLEDGE_TOP_K=3
KNOWLEDGE_RELEVANCE_THRESHOLD=0.35
KNOWLEDGE_UPLOAD_MAX_FILE_SIZE_MB=10
KNOWLEDGE_UPLOAD_MAX_FILES=5

LOG_LEVEL=INFO
